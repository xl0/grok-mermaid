{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "types": ["bun"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test", "scripts"],
  // gen-demo-svg needs lovely-ansi-svg, which is kept out of package.json so
  // the published manifest carries no dependencies at all; install it ad hoc
  // to regenerate the svg (see the script's header).
  "exclude": ["scripts/gen-demo-svg.ts"]
}
