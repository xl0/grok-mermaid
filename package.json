{
  "name": "lovely-mermaid-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "test:update": "UPDATE=1 bun test packages/lovely-mermaid/test/cases.test.ts",
    "check": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "tsgo --noEmit -p packages/lovely-mermaid",
    "differential": "bun run tools/differential/run.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/bun": "latest",
    "@typescript/native-preview": "latest"
  }
}
