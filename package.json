{
  "name": "lovely-mermaid-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "test:update": "UPDATE=1 bun test packages/lovely-mermaid/test/cases.test.ts",
    "check": "biome check . && cd demo && bun run check",
    "fix": "biome check --write .",
    "typecheck": "tsgo --noEmit -p packages/lovely-mermaid",
    "build": "cd packages/lovely-mermaid && bun run build",
    "dev": "cd demo && bun run dev",
    "release": "cd packages/lovely-mermaid && bun run release"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/bun": "latest",
    "@typescript/native-preview": "latest"
  }
}
